{
  "name": "clifingerprint",
  "version": "0.1.0",
  "description": "Record the observable contract of CLI tools and detect changes between builds.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "cli-fp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "check": "tsc --noEmit",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run build && npm test && npm run package:smoke",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "contract",
    "fingerprint",
    "snapshot",
    "approval-test",
    "regression",
    "baseline"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rogerchappel/clifingerprint"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/clifingerprint/issues"
  },
  "homepage": "https://github.com/rogerchappel/clifingerprint#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/yargs": "^17.0.33",
    "js-yaml": "^4.1.0",
    "typescript": "^5.4.5",
    "yargs": "^17.7.2"
  }
}
